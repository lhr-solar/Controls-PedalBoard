	(text "Accel & Brake ADC Signal Buffer"
		(exclude_from_sim no)
		(at 80.518 38.862 0)
		(effects
			(font
				(size 3 3)
				(thickness 0.4)
				(bold yes)
			)
		)
		(uuid "ab40fb8d-e2f4-48d3-969a-a3e58af0f262")
	)
	(text "Notes:\n\n·	Motor + refers to the pin that has battery voltage applied to it to open the throttle.\n·	It is recommended to use shielded cables for TPS and APS sensors.\n·	To prevent back feeding, the throttle motor relay must be controlled from a non flywheeled \noutput such as a spare Ignition or Injection channel.\n\n - If the sensor and microcontroller are powered from different systems\n or are physically far apart, consider using an op-amp buffer or isolation amplifier to ensure \naccurate signal transmission and reduce noise."
		(exclude_from_sim no)
		(at 150.114 144.018 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ebeac7a5-3474-4396-b270-e16f869c35d7")
	)
