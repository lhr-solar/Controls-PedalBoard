		)
		(uuid "0d42aae3-9d85-4a1b-a6e4-c524f21ce30c")
	)
	(text "Accel & Brake ADC Signal Buffer"
		(exclude_from_sim no)
		(at 132.08 36.83 0)
		(effects
			(font
				(size 3 3)
				(thickness 0.4)
				(bold yes)
