	(text "Vin = [0.25, 5]\nVdivider = Vin * 10/(10+5.6)\n\nVdivider_low = 0.25 * 10/15.6 = 0.16v\nVdivider_high = 5 * 10/15.6 = 3.205v"
		(exclude_from_sim no)
		(at 150.114 106.426 0)
